{
  "name": "razorpay-agent-studio-merchant-connector",
  "version": "1.0.0",
  "description": "Production-grade Private Merchant Connector for Razorpay Agent Studio (WooCommerce & Merchant Tools) with MCP support, OAuth/API key auth, resilient rate-limiting, and list/get/search primitives.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "razorpay",
    "agent-studio",
    "mcp",
    "woocommerce",
    "merchant-connector",
    "ai-agent"
  ],
  "author": "Forward Deployed Engineer Candidate",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
